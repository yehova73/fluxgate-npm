{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "dist"],
  "compilerOptions": {
    "rootDir": "./src",
    "target": "ES2020",
    "composite": true,
    "stripInternal": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "outDir": "dist"
  }
}