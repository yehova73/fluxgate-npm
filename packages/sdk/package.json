{
  "name": "@fluxgate/sdk",
  "version": "0.0.6",
  "description": "Core tracking SDK for FluxGate token usage, latency, and cost monitoring.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/types.d.ts",
      "import": "./dist/types/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run --root ../../",
    "test:watch": "npm run build && vitest --root ../../"
  },
  "keywords": [
    "llm",
    "tokens",
    "tracker",
    "openai",
    "claude",
    "gemini",
    "monitoring",
    "costs"
  ],
  "author": "FluxGate Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehova73/fluxgate-npm.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/yehova73/fluxgate-npm/issues"
  },
  "homepage": "https://fluxgate.app",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  }
}
