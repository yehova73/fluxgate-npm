{
  "name": "@fluxgate/openai",
  "version": "0.0.3",
  "description": "OpenAI wrapper for FluxGate token usage, latency, and cost monitoring.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/types.d.ts"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "npx rimraf dist tsconfig.tsbuildinfo",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../../",
    "test:watch": "vitest --root ../../"
  },
  "keywords": [
    "llm",
    "tokens",
    "tracker",
    "openai",
    "claude",
    "gemini",
    "monitoring",
    "costs"
  ],
  "author": "FluxGate Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yehova73/fluxgate-npm.git",
    "directory": "packages/openai"
  },
  "bugs": {
    "url": "https://github.com/yehova73/fluxgate-npm/issues"
  },
  "homepage": "https://fluxgate.app",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "openai": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fluxgate/sdk": "^0.0.6"
  }
}
