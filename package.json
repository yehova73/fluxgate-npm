{
  "name": "fluxgate",
  "version": "0.0.1",
  "description": "Fluxgate - Monitor and track LLM token usage and costs",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "scripts": {
    "build": "npm run build --workspace=packages/sdk && npm run build --workspaces",
    "dev": "tsc -b --watch",
    "test": "npm run build --workspace=packages/sdk && vitest run",
    "test:watch": "npm run build --workspace=packages/sdk && vitest",
    "test:coverage": "npm run build --workspace=packages/sdk && vitest run --coverage",
    "typecheck": "npm run build --workspace=packages/sdk && npm run typecheck -ws"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  }
}
