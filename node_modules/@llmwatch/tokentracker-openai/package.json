    "tracker",
    "openai",
    "claude",
    "gemini",
    "monitoring",
    "costs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "openai": "^6.34.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@llmwatch/tokentracker": "file:../tokentracker"
  }
